---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategorySection from "../components/CategorySection.astro";
import { categories, sites } from "../lib/catalog";
import { withBase } from "../lib/urls";
---

<BaseLayout>
  <section class="directory-intro">
    <div class="shell intro-grid">
      <div class="intro-copy">
        <p class="eyebrow">Independent adult site directory</p>
        <h1>Find a site worth visiting.</h1>
        <p>
          Browse hand-organized categories, open a site directly, or check its directory page before you visit.
        </p>
      </div>
      <form class="hero-search" action={withBase("/search/")} method="get" role="search">
        <label class="sr-only" for="home-search">Search the directory</label>
        <input id="home-search" name="q" type="search" placeholder={`Search ${sites.length} sites`} autocomplete="off" />
        <button type="submit">Search</button>
      </form>
    </div>
    <nav class="shell category-quick-links" aria-label="Jump to a category">
      <span>Jump to:</span>
      {categories.map((category) => (
        <a href={`#category-${category.slug}`}>{category.shortName}</a>
      ))}
    </nav>
  </section>

  <section class="directory-browser" aria-labelledby="directory-title">
    <div class="shell">
      <header class="directory-heading">
        <div>
          <p class="eyebrow">The directory</p>
          <h2 id="directory-title">Browse by category</h2>
          <p>{categories.length} categories · {sites.length} sites in this preview</p>
        </div>
        <div class="directory-heading-actions">
          <span><b aria-hidden="true">↗</b> opens the website</span>
          <span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h8l3 3v14H7zM15 3.5v3h3M10 11h5M10 15h5"></path></svg>
            opens site details
          </span>
          <a class="text-link" href={withBase("/categories/")}>All categories</a>
        </div>
      </header>
      <div class="directory-sections directory-board">
        {categories.map((category) => <CategorySection category={category} />)}
      </div>
    </div>
  </section>
</BaseLayout>
