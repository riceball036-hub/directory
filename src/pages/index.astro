---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategorySection from "../components/CategorySection.astro";
import { categories } from "../lib/catalog";
---

<BaseLayout>
  <section class="directory-browser" aria-labelledby="directory-title">
    <div class="shell">
      <h1 id="directory-title" class="sr-only">Adult website directory</h1>
      <div class="directory-sections directory-board">
        {categories.map((category) => <CategorySection category={category} />)}
      </div>
    </div>
  </section>
</BaseLayout>
