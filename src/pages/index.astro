---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategorySection from "../components/CategorySection.astro";
import { categories, sites } from "../lib/catalog";
import { withBase } from "../lib/urls";
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Independent adult website directory</p>
        <h1>Adult sites, sorted.<br /><span>Click and explore.</span></h1>
        <p class="hero-copy">
          Find websites quickly through clear categories and compact ranked lists. Click a site name to visit it directly, or use the small Review button for our notes.
        </p>
        <form class="hero-search" action={withBase("/search/")} method="get" role="search">
          <label class="sr-only" for="home-search">Search the directory</label>
          <input id="home-search" name="q" type="search" placeholder={`Search ${sites.length} directory entries`} autocomplete="off" />
          <button type="submit">Search</button>
        </form>
        <div class="hero-stats" aria-label="Directory statistics">
          <span><strong>{sites.length}</strong> reviewed entries</span>
          <span><strong>{categories.length}</strong> clear categories</span>
          <span><strong>0</strong> pop-ups</span>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Directory principles">
        <p class="panel-index">QUICK DIRECTORY</p>
        <h2>A fast index, not a wall of cards.</h2>
        <ul>
          <li><span>01</span> Four category columns on desktop</li>
          <li><span>02</span> Direct website links by default</li>
          <li><span>03</span> Small optional review buttons</li>
          <li><span>04</span> Fast on desktop and mobile</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="category-jump" aria-labelledby="browse-title">
    <div class="shell">
      <div class="section-heading section-heading-wide">
        <div>
          <p class="eyebrow">Jump to a list</p>
          <h2 id="browse-title">Choose a category</h2>
        </div>
        <a class="text-link" href={withBase("/categories/")}>View category index</a>
      </div>
      <div class="category-chip-rail">
        {categories.map((category) => (
          <a href={withBase(`/categories/${category.slug}/`)}>
            <span aria-hidden="true">{category.icon}</span>
            <strong>{category.shortName}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="directory-browser" aria-labelledby="directory-title">
    <div class="shell">
      <header class="directory-heading">
        <div>
          <p class="eyebrow">Main directory</p>
          <h2 id="directory-title">Browse every category</h2>
        </div>
        <p>Scan four categories at a glance, visit a site directly, or open a short review when you want more detail.</p>
      </header>
      <div class="directory-sections">
        {categories.map((category) => <CategorySection category={category} />)}
      </div>
    </div>
  </section>

  <section class="editorial-note">
    <div class="shell editorial-grid">
      <div>
        <p class="eyebrow">How the index works</p>
        <h2>Direct links when you want speed. Reviews when you want detail.</h2>
      </div>
      <div>
        <p>
          Listings are designed around practical facts: what a platform offers, how access works, which devices it supports, and what a visitor should verify independently.
        </p>
        <a class="button button-outline" href={withBase("/about/")}>Read the editorial method</a>
      </div>
    </div>
  </section>
</BaseLayout>
