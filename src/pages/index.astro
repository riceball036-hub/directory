---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategorySection from "../components/CategorySection.astro";
import { categories, sites } from "../lib/catalog";
import { withBase } from "../lib/urls";
---

<BaseLayout>
  <section class="directory-intro">
    <div class="shell intro-grid">
      <div class="intro-copy">
        <p class="eyebrow">Independent adult website directory</p>
        <h1>Find the right site, fast.</h1>
        <p>
          Browse clearly labeled categories and short summaries. Click any site name to visit it directly, or select the <strong>ⓘ</strong> icon for more detail.
        </p>
      </div>
      <form class="hero-search" action={withBase("/search/")} method="get" role="search">
        <label class="sr-only" for="home-search">Search the directory</label>
        <input id="home-search" name="q" type="search" placeholder={`Search ${sites.length} sites`} autocomplete="off" />
        <button type="submit">Search</button>
      </form>
    </div>
    <nav class="shell category-quick-links" aria-label="Browse categories">
      <span>Categories:</span>
      {categories.map((category) => (
        <a href={`#category-${category.slug}`}>{category.shortName}</a>
      ))}
    </nav>
  </section>

  <section class="directory-browser" aria-labelledby="directory-title">
    <div class="shell">
      <header class="directory-heading">
        <div>
          <h2 id="directory-title">Browse by category</h2>
          <p>{categories.length} categories · {sites.length} listed sites</p>
        </div>
        <a class="text-link" href={withBase("/categories/")}>View all categories →</a>
      </header>
      <div class="directory-sections">
        {categories.map((category) => <CategorySection category={category} />)}
      </div>
    </div>
  </section>
</BaseLayout>
