---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
---

<BaseLayout title="Page not found" noindex>
  <div class="shell not-found">
    <p class="eyebrow">Error 404</p>
    <h1>This page is not in the index.</h1>
    <p>Return to the directory or search for a listing.</p>
    <div>
      <a class="button button-primary" href={withBase("/")}>Go home</a>
      <a class="button button-outline" href={withBase("/search/")}>Search listings</a>
    </div>
  </div>
</BaseLayout>
