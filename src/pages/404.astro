---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <div class="shell not-found">
    <p class="eyebrow">Error 404</p>
    <h1>This page is not in the index.</h1>
    <p>Return to the directory or browse all categories.</p>
    <div>
      <a class="button button-primary" href="/">Go home</a>
      <a class="button button-outline" href="/categories/">Browse categories</a>
    </div>
  </div>
</BaseLayout>

