---
import { siteConfig } from "../config";
import { sites } from "../lib/catalog";
import { withBase } from "../lib/urls";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase("/")} aria-label={`${siteConfig.name} home`}>
      <span class="brand-mark" aria-hidden="true">18+</span>
      <span class="brand-copy"><strong>{siteConfig.name}</strong></span>
    </a>
    <form class="header-search" action={withBase("/search/")} method="get" role="search">
      <label class="sr-only" for="header-search-input">Search the directory</label>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input id="header-search-input" name="q" type="search" placeholder={`Search ${sites.length} sites`} autocomplete="off" />
      <button type="submit">Search</button>
    </form>
  </div>
</header>
