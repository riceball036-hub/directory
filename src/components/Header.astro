---
import { navigation, siteConfig } from "../config";
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <span class="brand-mark" aria-hidden="true">D</span>
      <span class="brand-copy">
        <strong>{siteConfig.name}</strong>
        <small>adult site index</small>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
      <span></span><span></span><span></span>
      <span class="sr-only">Toggle navigation</span>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary" data-primary-nav>
      {navigation.map((item) => {
        const active = item.href === "/"
          ? currentPath === "/"
          : currentPath.startsWith(item.href);
        return (
          <a href={item.href} aria-current={active ? "page" : undefined}>{item.label}</a>
        );
      })}
    </nav>
  </div>
</header>

