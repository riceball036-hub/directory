---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<svg
  class="category-svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {slug === "free-video-sites" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="3"></rect>
      <path d="m10 9 5 3-5 3Z"></path>
    </>
  )}
  {slug === "premium-memberships" && (
    <>
      <path d="M6 3h12l3 5-9 13L3 8l3-5Z"></path>
      <path d="m3 8 9 5 9-5M8 3l4 10 4-10"></path>
    </>
  )}
  {slug === "live-cams" && (
    <>
      <rect x="3" y="6" width="13" height="12" rx="3"></rect>
      <path d="m16 10 5-3v10l-5-3"></path>
    </>
  )}
  {slug === "creator-platforms" && (
    <>
      <circle cx="8.5" cy="8" r="3"></circle>
      <path d="M3 19c.7-3.2 2.5-5 5.5-5s4.8 1.8 5.5 5"></path>
      <path d="m18 7 .8 1.7 1.8.3-1.3 1.3.3 1.8-1.6-.9-1.6.9.3-1.8L15.4 9l1.8-.3L18 7Z"></path>
    </>
  )}
  {slug === "vr-interactive" && (
    <>
      <path d="M4 7h16l1 5a4 4 0 0 1-4 5h-1l-3-4h-2l-3 4H7a4 4 0 0 1-4-5l1-5Z"></path>
      <path d="M8 10h.01M16 10h.01"></path>
    </>
  )}
  {slug === "stories-audio" && (
    <>
      <path d="M4 13v-2a8 8 0 0 1 16 0v2"></path>
      <path d="M4 13h3v7H5a2 2 0 0 1-2-2v-3a2 2 0 0 1 1-2ZM20 13h-3v7h2a2 2 0 0 0 2-2v-3a2 2 0 0 0-1-2Z"></path>
    </>
  )}
  {slug === "dating-communities" && (
    <path d="M20.8 4.7a5.4 5.4 0 0 0-7.6 0L12 5.9l-1.2-1.2a5.4 5.4 0 1 0-7.6 7.6L12 21l8.8-8.7a5.4 5.4 0 0 0 0-7.6Z"></path>
  )}
  {slug === "inclusive-sites" && (
    <>
      <path d="m12 3 1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8L12 3Z"></path>
      <path d="m19 15 .8 1.8L22 18l-2.2 1.2L19 21l-.8-1.8L16 18l2.2-1.2L19 15ZM5 14l.8 1.8L8 17l-2.2 1.2L5 20l-.8-1.8L2 17l2.2-1.2L5 14Z"></path>
    </>
  )}
</svg>
